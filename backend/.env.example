PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/locker_system?schema=public"

# Admin security. Change these before production.
ADMIN_PIN=2026
ADMIN_SESSION_SECRET=change-this-long-random-secret-before-production
ADMIN_SESSION_TTL_SECONDS=28800

# Integration readiness switches. Keep MOCK/FILE/MANUAL for local demo.
PAYMENT_MODE=MOCK
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

HARDWARE_MODE=MOCK
ESP32_BASE_URL=
ESP32_API_TOKEN=

SMS_MODE=MOCK
SMS_PROVIDER=DEVSMS
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546
DEVSMS_BASE_URL=https://devsms.uz/api
DEVSMS_TOKEN=
DEVSMS_SENDER=4546
DEVSMS_TYPE=universal_otp
DEVSMS_MESSAGE_TYPE=eskiz
DEVSMS_TEMPLATE_TYPE=1
DEVSMS_SERVICE_NAME=City Mall
SMS_AUTH_MESSAGE={code}
# Keep false locally so SMS limits are not spent during development.
SMS_ALLOW_LOCAL_SEND=false

ONE_C_MODE=FILE
ONE_C_BASE_URL=
ONE_C_API_TOKEN=

GOOGLE_SHEETS_MODE=DISABLED
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with escaped newlines: -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_PAYMENTS_SHEET=Payments
GOOGLE_SHEETS_TARIFFS_SHEET=Tariffs

CCTV_MODE=MANUAL
CCTV_BASE_URL=
CCTV_API_TOKEN=
CCTV_DEFAULT_CAMERA_ID=
CCTV_RETENTION_DAYS=30
